@page "/azure"
@rendermode WasmRenderModes.Interactive
@using Microsoft.AspNetCore.SignalR.Client
@using PoPunkouterSoftware.Shared.Azure
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject NotificationService NotificationService
@inject NavigationManager NavManager

<PageTitle>Po Software — Azure Monitor</PageTitle>

<div class="app-page azure-ops-page">
@if (_loading)
{
    <div class="app-card">
        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" class="rz-my-3" />
        <p class="app-note rz-mb-0">Loading Azure report…</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Outlined" ShowIcon="true" class="rz-my-4">
        <div><strong>Azure dashboard load failed.</strong></div>
        <div class="app-mt-35">@_loadError</div>
        <div class="app-mt-75">
            <RadzenButton Text="Retry" Icon="refresh" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(async () => await LoadReportAsync())" />
        </div>
    </RadzenAlert>
}
else
{
    var currentReport = report ?? new AzureReport();
    var active = currentReport.WebServices?.ByStatus?.Active ?? 0;
    var broken = currentReport.WebServices?.ByStatus?.Broken ?? 0;
    var total = currentReport.WebServices?.Total ?? 0;
    var healthPct = total > 0 ? (int)(active * 100.0 / total) : 100;
    var ageMin = currentReport.GeneratedAt is DateTime generated
        ? (int)(DateTime.UtcNow - generated).TotalMinutes : -1;
    var ageLabel = ageMin < 0 ? "Unknown age" : ageMin < 60 ? $"{ageMin}m old" : ageMin < 1440 ? $"{ageMin / 60}h {ageMin % 60}m old" : $"{ageMin / 1440}d {ageMin % 1440 / 60}h old";
    var insecureCount = (currentReport.StorageInventory ?? new()).Count(s => s.PublicBlobAccess || !s.HttpsOnly || s.MinTls is "TLS1_0" or "TLS1_1");
    var criticalDriftCount = (currentReport.ConfigDrift ?? new()).Count(d => d.Issues?.Any(i => i.Severity is "critical" or "high") == true);
    var totalSecurityFindings = insecureCount + criticalDriftCount;
    var securityIssueCount = (currentReport.StorageInventory ?? new()).Sum(s => s.IssueCount)
        + (currentReport.ConfigDrift ?? new()).Sum(d => d.IssueCount);

    <header class="azure-command-header @(PriorityQueue.Count > 0 ? "has-attention" : "is-healthy")">
        <div class="azure-command-copy">
            <div class="app-kicker">Azure · @(currentReport.Subscription?.Name ?? "—")</div>
            <h1 class="azure-hero-title">Azure operations</h1>
            <p class="azure-command-summary">
                @if (PriorityQueue.Count > 0)
                {
                    <strong>@PriorityQueue.Count item(s) need review.</strong>
                    <span> Start with the highest-impact work below.</span>
                }
                else
                {
                    <strong>All systems operational.</strong>
                    <span> No immediate actions were detected.</span>
                }
            </p>
            <div class="azure-command-meta">
                <span>Generated @(currentReport.GeneratedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—") UTC</span>
                <RadzenBadge Text="@ageLabel" IsPill="true" BadgeStyle="@(ageMin < 30 ? BadgeStyle.Success : ageMin < 120 ? BadgeStyle.Info : ageMin < 360 ? BadgeStyle.Warning : BadgeStyle.Danger)" />
            </div>
        </div>
        <div class="azure-command-kpis" aria-label="Azure report summary">
            <div><strong>@healthPct%</strong><span>Fleet health</span></div>
            <div><strong>@(currentReport.Cost?.TotalFormatted ?? "$0.00")</strong><span>30-day cost</span></div>
            <div><strong>@CleanupCandidates.Count</strong><span>Cleanup</span></div>
            <div><strong>@totalSecurityFindings</strong><span>Security</span></div>
        </div>
        <div class="azure-command-actions">
            <RadzenButton Text="@(_refreshing ? "Refreshing…" : "Refresh from Azure")" Icon="refresh"
                          ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                          Disabled="@_refreshing" Click="RefreshAsync" />
            <RadzenButton Text="Download JSON" Icon="download" ButtonStyle="ButtonStyle.Light"
                          Variant="Variant.Outlined" Size="ButtonSize.Small"
                          Disabled="@(report == null)" Click="DownloadReportAsync" />
            <RadzenButton Text="Download audit script" Icon="terminal" ButtonStyle="ButtonStyle.Light"
                          Variant="Variant.Outlined" Size="ButtonSize.Small" Click="DownloadAutomationScript" />
            @if (_refreshing)
            {
                <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="CancelRefreshAsync" />
            }
        </div>
    </header>

    <nav class="azure-sticky-nav" aria-label="Azure dashboard sections">
        <a href="#attention">Attention <span>@PriorityQueue.Count</span></a>
        <a href="#overview">Overview</a>
        <a href="#performance">Performance</a>
        <a href="#resources">Resources <span>@(currentReport.AllResourceSummary?.Total ?? 0)</span></a>
        <a href="#details">Details</a>
    </nav>

    @if (_refreshing)
    {
        <section class="app-section azure-refresh-progress" aria-live="polite">
            <RadzenProgressBar Value="@_progressPercent" Max="100" ShowValue="true" Style="height:22px" />
            <span><RadzenIcon Icon="sync" class="app-progress-icon" /> @_progressStep</span>
        </section>
    }

    <section id="attention" class="app-section azure-anchor-section">
        <div class="azure-section-heading">
            <div>
                <div class="app-kicker">Priority queue</div>
                <h2>Needs attention</h2>
                <p>Reliability, security, configuration, certificate, and cleanup findings ranked by impact.</p>
            </div>
            @if (PriorityQueue.Count > 0)
            {
                <RadzenBadge Text="@($"{PriorityQueue.Count} open")" BadgeStyle="BadgeStyle.Danger" IsPill="true" />
            }
        </div>
        @if (PriorityQueue.Count == 0)
        {
            <div class="azure-compact-state success"><RadzenIcon Icon="check_circle" /> No immediate action is required.</div>
        }
        else
        {
            <div class="azure-attention-list">
                @foreach (var item in PriorityQueue)
                {
                    <article class="azure-attention-item">
                        <div class="azure-item-heading">
                            <RadzenBadge Text="@item.Actionability" IsPill="true" BadgeStyle="@ActionabilityBadge(item.Actionability)" />
                            <strong>@item.Item</strong>
                            <span class="azure-attention-reason">@item.Reason</span>
                            <span class="azure-impact-score">Impact @item.ImpactScore</span>
                        </div>
                        <div class="azure-attention-detail">
                            <dl>
                                <div><dt>Source</dt><dd>@item.Source</dd></div>
                                <div><dt>Confidence</dt><dd>@item.Confidence</dd></div>
                                <div><dt>Owner</dt><dd>@item.Owner</dd></div>
                                <div><dt>Environment</dt><dd>@item.Environment</dd></div>
                            </dl>
                            @if (!string.IsNullOrWhiteSpace(item.Command))
                            {
                                <button class="azure-copy-command" @onclick="@(() => CopyText(item.Command))" title="Copy Azure CLI command">
                                    <code>@item.Command</code><RadzenIcon Icon="content_copy" />
                                </button>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="app-section">
        <div class="app-card">
            <div class="app-toolbar">
                <div>
                    <div class="app-kicker">Subscription automation</div>
                    <h2 class="app-card-title">Generate a portable Azure efficiency report</h2>
                    <p class="app-note rz-mb-0">
                        Download the PowerShell 7 script, run it locally with Azure CLI installed, and select a subscription.
                        It creates a standalone HTML inventory and a separate cleanup script whose commands remain commented out.
                    </p>
                </div>
                <RadzenButton Text="Download PowerShell script" Icon="download"
                              ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                              Click="DownloadAutomationScript" />
            </div>
            <div class="app-callout info rz-mt-3">
                <strong>Run:</strong> <code>pwsh ./New-AzureEfficiencyReport.ps1</code><br />
                <span class="app-note">Prerequisites: PowerShell 7 and Azure CLI. The script installs the Resource Graph extension when needed and never reads secret values.</span>
            </div>
        </div>
    </section>

    <section id="overview" class="app-section azure-anchor-section">
        <div class="azure-section-heading">
            <div><div class="app-kicker">Overview</div><h2>Operational snapshot</h2><p>The four signals most useful for deciding what to investigate next.</p></div>
        </div>
        <div class="azure-chart-grid">
            <article class="app-card">
                <h3 class="app-card-title">Fleet health</h3>
                <p class="app-note">Active, broken, and other services.</p>
                <div class="azure-donut-wrap">
                    <RadzenChart Style="height:230px">
                        <RadzenDonutSeries TItem="ChartPoint" Data="@FleetHealthDonutData" CategoryProperty="Label" ValueProperty="Value" InnerRadius="75" />
                        <RadzenLegend Position="LegendPosition.Bottom" />
                    </RadzenChart>
                    <div class="azure-donut-center"><div class="azure-donut-pct">@healthPct%</div><div class="azure-donut-caption">healthy</div></div>
                </div>
            </article>
            <article class="app-card">
                <h3 class="app-card-title">Top cost drivers</h3>
                <p class="app-note">Largest contributors to @(currentReport.Cost?.TotalFormatted ?? "—") over 30 days.</p>
                @if (CostDriversBarData.Count == 0)
                {
                    <div class="azure-compact-state">No cost data in the latest report.</div>
                }
                else
                {
                    <RadzenChart Style="height:230px">
                        <RadzenBarSeries TItem="ChartPoint" Data="@CostDriversBarData.Take(6)" CategoryProperty="Label" ValueProperty="Value" Title="USD" />
                        <RadzenValueAxis FormatString="${0:F2}"><RadzenGridLines Visible="true" /></RadzenValueAxis>
                        <RadzenCategoryAxis /><RadzenLegend Visible="false" />
                    </RadzenChart>
                }
            </article>
        </div>
    </section>

    <section id="performance" class="app-section azure-anchor-section">
        <div class="azure-section-heading">
            <div><div class="app-kicker">Performance</div><h2>Response time and reliability</h2><p>Slow applications and server errors share one investigation surface.</p></div>
        </div>
        <div class="azure-chart-grid">
            <article class="app-card">
                <h3 class="app-card-title">Slowest response times</h3>
                <p class="app-note">Current probe response, highest first.</p>
                @if (ResponseTimeBarData.Count == 0)
                {
                    <div class="azure-compact-state success">No response-time data to review.</div>
                }
                else
                {
                    <RadzenChart Style="height:240px">
                        <RadzenBarSeries TItem="ChartPoint" Data="@ResponseTimeBarData.Take(8)" CategoryProperty="Label" ValueProperty="Value" Title="ms" />
                        <RadzenValueAxis FormatString="{0:N0} ms"><RadzenGridLines Visible="true" /></RadzenValueAxis>
                        <RadzenCategoryAxis /><RadzenLegend Visible="false" />
                    </RadzenChart>
                }
            </article>
            <article class="app-card">
                <h3 class="app-card-title">7-day server errors</h3>
                <p class="app-note">Services reporting HTTP 5xx responses.</p>
                @if (ErrorRateBarData.Count == 0)
                {
                    <div class="azure-compact-state success"><RadzenIcon Icon="check_circle" /> No 5xx errors detected.</div>
                }
                else
                {
                    <RadzenChart Style="height:240px">
                        <RadzenBarSeries TItem="ChartPoint" Data="@ErrorRateBarData.Take(8)" CategoryProperty="Label" ValueProperty="Value" Title="5xx" />
                        <RadzenValueAxis FormatString="{0:N0}"><RadzenGridLines Visible="true" /></RadzenValueAxis>
                        <RadzenCategoryAxis /><RadzenLegend Visible="false" />
                    </RadzenChart>
                }
            </article>
        </div>
    </section>

    <section id="resources" class="app-section azure-anchor-section">
        <div class="azure-section-heading azure-resource-heading">
            <div><div class="app-kicker">Resource explorer</div><h2>One inventory, multiple views</h2><p>Filter the same resource list by operational concern instead of switching reports.</p></div>
            <span class="azure-result-count">@FilteredResourceExplorerItems.Count of @ResourceExplorerItems.Count resources</span>
        </div>
        <div class="azure-filter-bar" role="group" aria-label="Filter resources">
            @foreach (var view in ResourceViews)
            {
                <RadzenButton Text="@view" Size="ButtonSize.Small"
                              ButtonStyle="@(_resourceView == view ? ButtonStyle.Primary : ButtonStyle.Light)"
                              Variant="Variant.Outlined" Click="@(() => _resourceView = view)" />
            }
        </div>
        @if (FilteredResourceExplorerItems.Count == 0)
        {
            <div class="azure-compact-state success"><RadzenIcon Icon="check_circle" /> No resources match this view.</div>
        }
        else
        {
            <div class="azure-resource-grid app-table-frame">
                <RadzenDataGrid Data="@FilteredResourceExplorerItems" TItem="ResourceExplorerItem" AllowSorting="true" AllowFiltering="true"
                                FilterMode="FilterMode.Simple" AllowPaging="false"
                                GridLines="DataGridGridLines.Horizontal" Style="width:100%;min-width:900px">
                    <Columns>
                        <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="Name" Title="Resource" Width="210px"><Template Context="item"><strong>@item.Name</strong></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="Type" Title="Type" Width="150px" />
                        <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="ResourceGroup" Title="Resource group" Width="160px" />
                        <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="Location" Title="Location" Width="110px" />
                        <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="Sku" Title="SKU" Width="90px" />
                        <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="Status" Title="Status" Width="115px"><Template Context="item"><RadzenBadge Text="@item.Status" BadgeStyle="@ExplorerStatusBadge(item.Status)" IsPill="true" /></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="Risk" Title="Concern" Width="130px"><Template Context="item"><span class="azure-risk-label @RiskClass(item.Risk)">@item.Risk</span></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="Requests7d" Title="Req 7d" Width="90px" TextAlign="TextAlign.Right" />
                        <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="Errors7d" Title="5xx" Width="70px" TextAlign="TextAlign.Right" />
                        <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="ResponseTimeMs" Title="Response" Width="100px" TextAlign="TextAlign.Right"><Template Context="item">@(item.ResponseTimeMs is int ms ? $"{ms:N0} ms" : "—")</Template></RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
            <div class="azure-resource-cards">
                @foreach (var item in FilteredResourceExplorerItems)
                {
                    <article class="azure-resource-card">
                        <div class="azure-resource-card-heading"><strong>@item.Name</strong><RadzenBadge Text="@item.Status" BadgeStyle="@ExplorerStatusBadge(item.Status)" IsPill="true" /></div>
                        <dl>
                            <div><dt>Type</dt><dd>@item.Type</dd></div><div><dt>Resource group</dt><dd>@item.ResourceGroup</dd></div>
                            <div><dt>Location</dt><dd>@item.Location</dd></div><div><dt>SKU</dt><dd>@item.Sku</dd></div>
                            <div><dt>Concern</dt><dd>@item.Risk</dd></div><div><dt>Requests / 5xx</dt><dd>@item.Requests7d.ToString("N0") / @item.Errors7d.ToString("N0")</dd></div>
                            <div><dt>Response</dt><dd>@(item.ResponseTimeMs is int ms ? $"{ms:N0} ms" : "—")</dd></div>
                        </dl>
                    </article>
                }
            </div>
        }
    </section>

    <section id="details" class="app-section azure-anchor-section">
        <div class="azure-section-heading"><div><div class="app-kicker">Details</div><h2>Evidence and history</h2><p>All report evidence is visible below without tabs or expandable controls.</p></div></div>
        <div class="azure-disclosure-stack">
            @if (securityIssueCount == 0)
            {
                <div class="azure-compact-state success"><RadzenIcon Icon="verified_user" /> Security configuration checks passed.</div>
            }
            else
            {
                <section class="azure-disclosure">
                    <div class="azure-disclosure-heading"><span><RadzenIcon Icon="security" /><strong>Security and configuration</strong></span><RadzenBadge Text="@($"{securityIssueCount} findings")" BadgeStyle="@(totalSecurityFindings > 0 ? BadgeStyle.Danger : BadgeStyle.Warning)" IsPill="true" /></div>
                    <div class="azure-disclosure-body">
                        @foreach (var storage in (currentReport.StorageInventory ?? new()).Where(s => s.IssueCount > 0))
                        {
                            <article class="azure-finding"><strong>@storage.Name</strong><span>@storage.ResourceGroup · @storage.MinTls</span><p>@string.Join("; ", storage.Issues?.Select(i => i.Issue) ?? [])</p></article>
                        }
                        @foreach (var drift in (currentReport.ConfigDrift ?? new()).Where(d => d.IssueCount > 0))
                        {
                            <article class="azure-finding"><strong>@(drift.FriendlyName ?? drift.Name)</strong><span>@drift.ResourceGroup · Configuration</span><p>@string.Join("; ", drift.Issues?.Select(i => i.Issue) ?? [])</p></article>
                        }
                    </div>
                </section>
            }

            @if (CleanupCandidates.Count == 0)
            {
                <div class="azure-compact-state success"><RadzenIcon Icon="delete_sweep" /> No cleanup candidates detected.</div>
            }
            else
            {
                <section class="azure-disclosure">
                    <div class="azure-disclosure-heading"><span><RadzenIcon Icon="delete_sweep" /><strong>Cleanup evidence</strong></span><RadzenBadge Text="@($"{CleanupCandidates.Count} candidates")" BadgeStyle="BadgeStyle.Warning" IsPill="true" /></div>
                    <div class="azure-disclosure-body">
                        @foreach (var item in CleanupCandidates)
                        {
                            <article class="azure-finding"><strong>@item.Name</strong><span>@item.Type · @item.ResourceGroup · @item.Confidence confidence</span><p>@item.Reason</p></article>
                        }
                    </div>
                </section>
            }

            @if (currentReport.DowntimeDiagnoses?.Count > 0)
            {
                <section class="azure-disclosure">
                    <div class="azure-disclosure-heading"><span><RadzenIcon Icon="troubleshoot" /><strong>Downtime diagnosis</strong></span><RadzenBadge Text="@($"{currentReport.DowntimeDiagnoses.Count} services")" BadgeStyle="BadgeStyle.Danger" IsPill="true" /></div>
                    <div class="azure-disclosure-body">
                        @foreach (var diagnosis in currentReport.DowntimeDiagnoses)
                        {
                            <article class="azure-finding"><strong>@(diagnosis.FriendlyName ?? diagnosis.Name)</strong><span>@diagnosis.HttpStatus</span><p>@diagnosis.LikelyCause</p><p><strong>Suggested fix:</strong> @diagnosis.SuggestedFix</p></article>
                        }
                    </div>
                </section>
            }

            @if (HasHistory)
            {
                <section class="azure-disclosure">
                    <div class="azure-disclosure-heading"><span><RadzenIcon Icon="timeline" /><strong>30-day history</strong></span><span class="app-note">@HistoryWindow.Count daily snapshots</span></div>
                    <div class="azure-disclosure-body azure-history-grid">
                        <article><h3>Fleet status</h3><RadzenChart Style="height:240px"><RadzenLineSeries TItem="StatusHistPoint" Data="@ServiceStatusHistory" CategoryProperty="Label" ValueProperty="Active" Title="Active" /><RadzenLineSeries TItem="StatusHistPoint" Data="@ServiceStatusHistory" CategoryProperty="Label" ValueProperty="Broken" Title="Broken" /><RadzenCategoryAxis /><RadzenValueAxis><RadzenGridLines Visible="true" /></RadzenValueAxis></RadzenChart></article>
                        <article><h3>30-day cost</h3><RadzenChart Style="height:240px"><RadzenLineSeries TItem="TimePoint" Data="@CostHistory" CategoryProperty="Label" ValueProperty="Value" Title="USD" /><RadzenCategoryAxis /><RadzenValueAxis FormatString="${0:F0}"><RadzenGridLines Visible="true" /></RadzenValueAxis></RadzenChart></article>
                    </div>
                </section>
            }
            else
            {
                <div class="azure-compact-state"><RadzenIcon Icon="timeline" /> History appears after two or more scans.</div>
            }

            @if (currentReport.StepTimings?.Count > 0)
            {
                <section class="azure-disclosure">
                    <div class="azure-disclosure-heading"><span><RadzenIcon Icon="speed" /><strong>Scan diagnostics</strong></span><span class="app-note">@StepTimingTotalMs.ToString("N0") ms total</span></div>
                    <div class="azure-disclosure-body">
                        @foreach (var timing in (currentReport.StepTimings ?? []).OrderByDescending(t => t.ElapsedMs))
                        {
                            <div class="azure-timing-row"><span>@timing.Step</span><strong>@timing.ElapsedMs.ToString("N0") ms</strong></div>
                        }
                    </div>
                </section>
            }
        </div>
    </section>
}
</div>
