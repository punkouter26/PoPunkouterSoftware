@page "/"
@rendermode WasmRenderModes.Interactive
@using PoPunkouterSoftware.Shared.Portfolio
@inject HttpClient Http

<PageTitle>PoPunkouterSoftware — Apps</PageTitle>

<main class="app-page portfolio-page">
    <header class="portfolio-header">
        <div>
            <span class="app-eyebrow">Punkouter Software</span>
            <h1>Web apps</h1>
            <p>Small tools and experiments built with .NET and Azure.</p>
        </div>
        <a class="portfolio-azure-link" href="/azure"><RadzenIcon Icon="monitor_heart" /><span>Azure status</span></a>
    </header>

    @if (apps is not null && apps.Count > 0)
    {
        var generatedAt = apps.Where(a => a.InventoryGeneratedAt.HasValue).Select(a => a.InventoryGeneratedAt).FirstOrDefault();
        var stale = generatedAt is DateTime dt && DateTime.UtcNow - dt > TimeSpan.FromHours(12);
        <div class="portfolio-summary" aria-live="polite">
            <strong>@apps.Count apps</strong>
            @if (generatedAt is DateTime updated)
            {
                <span class="@(stale ? "is-stale" : "")">Inventory updated @FormatAge(updated)@(stale ? " · stale" : "")</span>
            }
            <button type="button" @onclick="LoadAppsAsync" disabled="@_loading"><RadzenIcon Icon="refresh" /> Refresh list</button>
        </div>
    }

    @if (_loading && apps is null)
    {
        <div class="portfolio-skeleton-grid" aria-label="Loading portfolio">
            @for (var i = 0; i < 6; i++) { <div class="portfolio-skeleton"></div> }
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Outlined" ShowIcon="true">
            <strong>The app list could not be updated.</strong>
            <span>@_loadError</span>
            <RadzenButton Text="Retry" Icon="refresh" Size="ButtonSize.Small" Click="LoadAppsAsync" />
        </RadzenAlert>
    }
    else if (apps?.Count == 0)
    {
        <div class="app-empty-state">No apps are configured yet.</div>
    }
    else if (apps is not null)
    {
        <section class="app-grid cards" aria-label="Web applications">
            @foreach (var app in apps)
            {
                <PortfolioAppCard @key="app.Id" App="app" />
            }
        </section>
    }
</main>

@code {
    private List<PortfolioApp>? apps;
    private bool _loading;
    private string? _loadError;

    protected override Task OnInitializedAsync() => LoadAppsAsync();

    private async Task LoadAppsAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            apps = await Http.GetFromJsonAsync("/api/portfolio", AppJsonContext.Default.ListPortfolioApp) ?? new();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatAge(DateTime generatedAt)
    {
        var age = DateTime.UtcNow - generatedAt;
        return age.TotalMinutes < 60 ? $"{(int)age.TotalMinutes}m ago" :
            age.TotalHours < 24 ? $"{(int)age.TotalHours}h ago" : $"{(int)age.TotalDays}d ago";
    }
}
