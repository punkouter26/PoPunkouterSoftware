@using PoPunkouterSoftware.Shared.Portfolio
@using Radzen

<article class="app-card app-portfolio-card @StatusClass">
    @if (!string.IsNullOrEmpty(App.ScreenshotUrl))
    {
        <a class="app-screenshot-thumb" href="@App.Url" target="_blank" rel="noopener noreferrer" title="@($"Open {App.Name}")">
            <img src="@App.ScreenshotUrl" alt="@($"Preview of {App.Name}")" loading="lazy" width="390" height="844" />
        </a>
    }
    <div class="portfolio-card-heading">
        <div><div class="app-kicker">@(string.IsNullOrWhiteSpace(App.Category) ? "App" : App.Category)</div><h2 class="app-card-title">@App.Name</h2></div>
        <RadzenBadge Text="@StatusLabel" IsPill="true" BadgeStyle="@StatusBadge" />
    </div>
    <p class="app-card-copy">@App.Description</p>
    @if (App.Technologies?.Any() == true)
    {
        <div class="app-chip-row" aria-label="Technologies">
            @foreach (var tech in App.Technologies.Take(3)) { <RadzenBadge Text="@tech" BadgeStyle="BadgeStyle.Light" Variant="Variant.Flat" IsPill="true" /> }
        </div>
    }
    <div class="portfolio-card-actions">
        <a class="rz-button rz-button-sm rz-variant-filled rz-primary rz-shade-default" href="@App.Url" target="_blank" rel="noopener noreferrer" aria-label="@($"Open {App.Name} app")"><RadzenIcon Icon="open_in_new" /><span class="rz-button-text">Open</span></a>
        @if (!string.IsNullOrEmpty(App.GithubRepo)) { <a class="app-inline-link" href="@($"https://github.com/{App.GithubRepo}")" target="_blank" rel="noopener noreferrer" aria-label="@($"View {App.Name} source on GitHub")"><RadzenIcon Icon="code" /> Source</a> }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public PortfolioApp App { get; set; } = default!;
    private string StatusLabel => App.Status switch { "healthy" => "Live", "unavailable" => "Unavailable", _ => "Catalog" };
    private string StatusClass => App.Status switch { "healthy" => "is-healthy", "unavailable" => "is-unavailable", _ => "is-unmonitored" };
    private BadgeStyle StatusBadge => App.Status switch { "healthy" => BadgeStyle.Success, "unavailable" => BadgeStyle.Danger, _ => BadgeStyle.Info };
}
