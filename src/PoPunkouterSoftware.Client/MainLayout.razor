@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<RadzenComponents />

@* Skip-to-content link — first focusable element on every page, invisible until it
   receives keyboard focus. Tab order lands on it before the topbar nav, then jumps the
   visitor past the chrome directly to <main id="main-content">. *@
<a href="#main-content" class="app-skip-link">Skip to content</a>

@* The header is position:fixed, so RadzenLayout's grid never lays it out — the
   `grid-template-areas` override that used to sit here was inert. .rz-body reserves
   the header footprint via --app-header-reserve instead. *@
<RadzenLayout>
    <RadzenHeader>
        @* Spatial contract — Left: branding · Center: actions · Right: menu trigger.
           Brand and the right region are both `flex: 1 1 0` so the centre nav is
           optically centred.

           This layout is STATICALLY server-rendered (<Routes /> carries no render mode;
           only the page components are InteractiveWebAssembly). Nothing here may depend
           on a Blazor event handler or on OnInitializedAsync doing useful work — an
           @onclick never fires, and the server's injected HttpClient has no BaseAddress
           so a relative-URI fetch throws. A "MOCK DATA" badge and a Session/Logout slot
           lived here and could never render for exactly those reasons; both were removed
           rather than left as chrome that only looks functional. Drawer behaviour is
           wired from js/helpers.js, which is why it works. *@
        <nav class="app-topbar" aria-label="Primary navigation">
            <a href="/" class="app-topbar-brand">PoPunkouterSoftware</a>

            @* Centre region. Below 768px this collapses into a drawer; the toggle is
               wired from js/helpers.js (initTopbarDrawer) because MainLayout is
               statically server-rendered and cannot run Blazor event handlers. *@
            <div id="app-topbar-drawer" class="app-topbar-nav">
                <a href="/" class="app-topbar-link @NavClass("/")">
                    <span class="material-symbols-outlined" aria-hidden="true">home</span>Apps
                </a>
                <a href="/azure" class="app-topbar-link @NavClass("/azure")">
                    <span class="material-symbols-outlined" aria-hidden="true">monitor_heart</span>Azure
                </a>
            </div>

            <div class="app-topbar-session">
                <button type="button" class="app-topbar-menu" aria-expanded="false" aria-controls="app-topbar-drawer"
                        aria-label="Toggle navigation menu">
                    <span class="material-symbols-outlined" aria-hidden="true">menu</span>
                </button>
            </div>
        </nav>
    </RadzenHeader>
    <RadzenBody>
        <div class="app-shell-body">
            <DevErrorBoundary>
                @Body
            </DevErrorBoundary>
        </div>
    </RadzenBody>
</RadzenLayout>

@code {
    private string NavClass(string href)
    {
        var current = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (href == "/")
            return current == "" || current == "/" ? "active" : "";
        return current.StartsWith(href.TrimStart('/'), StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }
}
