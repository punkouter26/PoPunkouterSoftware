@* Month-end spend projected against a budget. "$12.08" tells the owner nothing; "on pace
   for $38 of your $40" tells them everything, which is the whole point of the ring.

   The projection comes from the scan's own burn-rate step via CostForecast — nothing is
   re-derived here. Set Budget:MonthlyUsd to turn the ring on; without it the component still
   shows the projection, just without a verdict, because a made-up default budget would
   invent a judgement the owner never asked for.

   The ring is inline SVG for the same reason Sparkline is: it is two circles and an arc. *@
@using System.Globalization
@using PoPunkouterSoftware.Shared

<article class="app-card azure-forecast" data-glass>
    <div class="azure-section-heading">
        <div>
            <div class="app-kicker">Spend</div>
            <h2 class="azure-glance-title">Month-end forecast</h2>
        </div>
        @if (Forecast.Verdict != CostVerdict.Unknown)
        {
            <RadzenBadge Text="@VerdictLabel" IsPill="true" BadgeStyle="@VerdictBadge" title="@VerdictTitle" />
        }
    </div>

    <div class="azure-forecast__body">
        <div class="azure-forecast__ring">
            <svg viewBox="0 0 120 120" role="img" aria-label="@RingAriaLabel" focusable="false">
                <circle class="azure-forecast__track" cx="60" cy="60" r="@Fmt(Radius)" />
                @if (Forecast.PercentOfBudget is not null)
                {
                    <circle class="azure-forecast__value @($"is-{Forecast.Verdict}")" cx="60" cy="60" r="@Fmt(Radius)"
                            stroke-dasharray="@($"{Fmt(ArcLength)} {Fmt(Circumference)}")"
                            stroke-dashoffset="0" transform="rotate(-90 60 60)" />
                }
            </svg>
            <div class="azure-forecast__center">
                @if (Forecast.PercentOfBudget is int pct)
                {
                    <div class="azure-forecast__pct">@pct%</div>
                    <div class="azure-forecast__caption">of budget</div>
                }
                else
                {
                    <div class="azure-forecast__pct">@Money(Forecast.ProjectedMonthTotal)</div>
                    <div class="azure-forecast__caption">projected</div>
                }
            </div>
        </div>

        <dl class="azure-forecast__facts">
            <div>
                <dt>Spent so far</dt>
                <dd>@Money(Forecast.SpentToDate)</dd>
            </div>
            <div>
                <dt>Projected month</dt>
                <dd>
                    @Money(Forecast.ProjectedMonthTotal)
                    @if (Forecast.ProjectionDelta is double d && Math.Abs(d) >= 0.01)
                    {
                        <span class="azure-forecast__delta @(d > 0 ? "dir-worse" : "dir-better")">
                            @(d > 0 ? "▲" : "▼") @Money(Math.Abs(d))
                        </span>
                    }
                </dd>
            </div>
            @if (Forecast.BudgetUsd is double budget)
            {
                <div>
                    <dt>Budget</dt>
                    <dd>@Money(budget)</dd>
                </div>
            }
        </dl>
    </div>

    @if (Forecast.BudgetUsd is null)
    {
        <p class="azure-chart-note">
            Set <code>Budget:MonthlyUsd</code> to compare this projection against a ceiling.
        </p>
    }
</article>

@code {
    [Parameter, EditorRequired] public CostForecast Forecast { get; set; } = new();

    private const double Radius = 50;
    private static readonly double Circumference = 2 * Math.PI * Radius;

    /// <summary>
    /// The drawn arc stops at a full circle. An overrun is still reported honestly — the
    /// percentage in the middle keeps counting past 100 and the ring turns red — but a
    /// dasharray longer than the circumference wraps and redraws over itself, which reads as
    /// a *shorter* arc the further over budget you go.
    /// </summary>
    private double ArcLength =>
        Circumference * Math.Clamp((Forecast.PercentOfBudget ?? 0) / 100d, 0, 1);

    private string VerdictLabel => Forecast.Verdict switch
    {
        CostVerdict.Over => "Over budget",
        CostVerdict.Near => "Close to budget",
        CostVerdict.Under => "On track",
        _ => "",
    };

    private BadgeStyle VerdictBadge => Forecast.Verdict switch
    {
        CostVerdict.Over => BadgeStyle.Danger,
        CostVerdict.Near => BadgeStyle.Warning,
        _ => BadgeStyle.Success,
    };

    private string VerdictTitle => Forecast.Verdict switch
    {
        CostVerdict.Over => "The projected month total exceeds the configured budget.",
        CostVerdict.Near => "The projection is at or above 80% of the configured budget.",
        _ => "The projection is comfortably below the configured budget.",
    };

    private string RingAriaLabel => Forecast.PercentOfBudget is int pct
        ? $"Projected {Money(Forecast.ProjectedMonthTotal)} this month, {pct}% of the {Money(Forecast.BudgetUsd ?? 0)} budget"
        : $"Projected {Money(Forecast.ProjectedMonthTotal)} this month; no budget configured";

    private static string Money(double value) => value.ToString("C2", CultureInfo.GetCultureInfo("en-US"));

    private static string Fmt(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}
