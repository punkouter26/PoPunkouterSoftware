@* First UI consumer of the AI triage feature. The default view renders the persisted
   per-scan AiSummaryResult (precomputed by ReportRefreshRunner — see AGENT.MD "AI triage").
   "Regenerate now" is a direct, unpersisted consumer of POST /api/diag/ai: it re-runs the
   model on the currently displayed attention items without a full Azure rescan.
   Reuses classes already styled by AzureDashboard.razor.css's `.azure-ops-page ::deep …`
   rules (app-card, azure-section-heading, azure-glance-title, azure-compact-state) instead
   of adding new CSS, since that file is off-limits for this change. *@
@using System.Text.Json
@inject HttpClient Http

<article class="app-card">
    <div class="azure-section-heading">
        <div>
            <div class="app-kicker">Azure · AI triage</div>
            <h2 class="azure-glance-title">AI summary</h2>
        </div>
        @if (Summary is not null)
        {
            <RadzenBadge Text="@SourceLabel(Summary.Source)" IsPill="true" BadgeStyle="@SourceBadgeStyle(Summary.Source)"
                          title="@SourceTitle(Summary.Source)" />
        }
    </div>

    @if (Summary is null || string.IsNullOrWhiteSpace(Summary.Text))
    {
        <div class="azure-compact-state">No AI summary yet — refresh Azure data to generate one.</div>
    }
    else
    {
        <p>@Summary.Text</p>
        <div class="app-note">
            Generated @RelativeTime.Format(Summary.GeneratedAtUtc.UtcDateTime)
            @if (!string.IsNullOrWhiteSpace(Summary.Model))
            {
                <text> · @Summary.Model</text>
            }
        </div>
    }

    <RadzenButton Text="@(_regenerating ? "Generating…" : "Regenerate now")" Icon="auto_awesome"
                  ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Size="ButtonSize.Small"
                  Disabled="@(_regenerating || AttentionItems is null)" Click="RegenerateAsync" />

    @if (_adHocText is not null)
    {
        <div class="azure-compact-state success">
            <div>
                <RadzenBadge Text="Ad-hoc" IsPill="true" BadgeStyle="BadgeStyle.Info"
                              title="A fresh, unpersisted summary from POST /api/diag/ai — not saved with the scan." />
                <p>@_adHocText</p>
            </div>
        </div>
    }
    @if (_adHocError is not null)
    {
        <div class="azure-compact-state">@_adHocError</div>
    }
</article>

@code {
    [Parameter] public AiSummaryResult? Summary { get; set; }

    /// <summary>Current attention items (from OpsSummary), sent to POST /api/diag/ai by
    /// "Regenerate now". Null before the summary has loaded — the button stays disabled.</summary>
    [Parameter] public IReadOnlyList<string>? AttentionItems { get; set; }

    private bool _regenerating;
    private string? _adHocText;
    private string? _adHocError;

    private static string SourceLabel(string source) => source switch
    {
        "ai" => "AI",
        "cached" => "Cached",
        "template-fallback" => "Rule-based",
        "disabled" => "Rule-based (AI off)",
        _ => source,
    };

    private static string SourceTitle(string source) => source switch
    {
        "ai" => "Freshly generated by the Hugging Face model this scan.",
        "cached" => "Attention items were unchanged since the last scan, so the previous AI text was reused.",
        "template-fallback" => "AI is enabled but the model call failed or returned nothing — showing a rule-based sentence instead.",
        "disabled" => "FeatureFlags:EnableAiSummary is off — showing a rule-based sentence instead of a model call.",
        _ => source,
    };

    private static BadgeStyle SourceBadgeStyle(string source) => source switch
    {
        "ai" => BadgeStyle.Success,
        "cached" => BadgeStyle.Info,
        _ => BadgeStyle.Secondary,
    };

    private async Task RegenerateAsync()
    {
        if (AttentionItems is null || _regenerating)
            return;

        _regenerating = true;
        _adHocError = null;
        StateHasChanged();

        try
        {
            var payload = JsonSerializer.Serialize(
                new AiTriageAdHocRequest(AttentionItems), AppJsonContext.Default.AiTriageAdHocRequest);
            using var content = new StringContent(payload, System.Text.Encoding.UTF8, "application/json");
            using var resp = await Http.PostAsync("/api/diag/ai", content);
            if (!resp.IsSuccessStatusCode)
            {
                _adHocText = null;
                _adHocError = $"AI request failed ({(int)resp.StatusCode}).";
                return;
            }

            using var doc = JsonDocument.Parse(await resp.Content.ReadAsStringAsync());
            var root = doc.RootElement;
            var available = root.TryGetProperty("available", out var a) && a.ValueKind == JsonValueKind.True;
            if (available && root.TryGetProperty("summary", out var s) && s.ValueKind == JsonValueKind.String)
            {
                _adHocText = s.GetString();
            }
            else
            {
                _adHocText = null;
                _adHocError = "AI summary is unavailable right now (feature disabled or the model is unreachable).";
            }
        }
        catch (Exception ex)
        {
            _adHocText = null;
            _adHocError = ex.Message;
        }
        finally
        {
            _regenerating = false;
            StateHasChanged();
        }
    }
}
