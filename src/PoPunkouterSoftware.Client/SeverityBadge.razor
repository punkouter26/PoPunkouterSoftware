@using Radzen

@* Shared markup for the Azure dashboard's three severity/status indicators: priority-queue
   actionability (AzurePriorityQueue), resource-explorer status (AzureResourceExplorer), and
   cleanup-candidate confidence (AzureEvidenceDisclosures). The domain-to-colour mapping stays
   where it always lived — AzureDashboard.Presentation's ActionabilityBadge / ExplorerStatusBadge
   / ConfidenceBadge — so this component only owns the shared markup and sizing (IsPill, no
   custom classes); callers keep their own domain meaning behind the resolved BadgeStyle they
   pass in. This is a markup refactor, not a redesign: it renders exactly what the three call
   sites rendered inline before. *@
<RadzenBadge Text="@Text" BadgeStyle="@Style" IsPill="true" />

@code {
    /// <summary>The label to render — an actionability tier, a resource status, or a
    /// confidence level.</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = "";

    /// <summary>Badge colour, already resolved by the caller.</summary>
    [Parameter] public BadgeStyle Style { get; set; } = BadgeStyle.Info;
}
