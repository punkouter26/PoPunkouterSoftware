@using PoPunkouterSoftware.Client
@using Radzen
@using Radzen.Blazor

@* The resource explorer: a segmented filter over every inventoried resource, rendered as a
   card list at every viewport.

   It used to render a RadzenDataGrid on wide viewports and these cards on narrow ones. The
   grid carried sorting, per-column filter menus, column resize and row virtualization over a
   list that measures 48 rows on the live subscription — machinery sized for a dataset this app
   does not have. It cost more than it looked: a virtualized grid torn down and rebuilt on
   every page render (which is why this component needed the largest ShouldRender guard in the
   codebase), a second full render tree to keep in step with the first, a matchMedia bridge
   through JS interop with a DotNetObjectReference and a dispose path purely to choose between
   them, and — the part that actually reached a visitor — a filter menu per column that put
   buttons named "*A*Contains" and "A**Starts with" into the accessibility tree above the
   segmented control that already filters this list.

   One tree, one breakpoint story: the cards reflow by themselves, so the wide layout is a CSS
   grid of the same articles rather than a different component. *@
<section class="azure-anchor-section">
    <div class="azure-section-heading azure-resource-heading">
        <div><div class="app-kicker">Resource explorer</div><h2>All resources</h2></div>
        <span class="azure-result-count">@Items.Count of @TotalCount</span>
    </div>

    @* Segmented control as a plain `role="group"` of buttons. RadzenSelectBar does not
       expose a way to set `aria-pressed` on each item, so the currently selected view was
       indistinguishable to a screen reader — five buttons, no signal of which one is on.
       Building the same shape from `<button aria-pressed>` keeps the visual treatment
       identical (the .rz-button classes below match Radzen's small size) and gives AT the
       fact it needed. `aria-pressed` is the right ARIA here, not `aria-selected`: every
       button stays focusable independently and the group is a filter rather than a tab
       list (the cards below are the content, not a tabpanel). *@
    <div class="azure-filter-bar" role="group" aria-label="Filter resources">
        @foreach (var view in Views)
        {
            var isSelected = string.Equals(view, SelectedView, StringComparison.OrdinalIgnoreCase);
            <button type="button"
                    class="rz-button rz-button-sm rz-button-text @(isSelected ? "rz-state-active" : null)"
                    aria-pressed="@(isSelected ? "true" : "false")"
                    @onclick="@(() => SelectedViewChanged.InvokeAsync(view))">
                @view
            </button>
        }
    </div>

    @if (Items.Count == 0)
    {
        <div class="azure-compact-state">No resources match the @SelectedView view.</div>
    }
    else
    {
        <div class="azure-resource-cards">
            @foreach (var item in Items)
            {
                @* @key on the composite identity, not the name: two resources in different
                   resource groups can share a name, and a duplicate key makes Blazor's diff
                   reuse the wrong element. *@
                <article class="azure-resource-card" @key="@($"{item.Type}|{item.ResourceGroup}|{item.Name}")">
                    <div class="azure-resource-card-heading">
                        <strong title="@item.Name">@item.Name</strong>
                        <SeverityBadge Text="@item.Status" Style="@StatusBadgeFor(item.Status)" />
                    </div>
                    <dl>
                        <div><dt>Type</dt><dd>@item.Type</dd></div>
                        <div><dt>Group</dt><dd>@item.ResourceGroup</dd></div>
                        <div><dt>Concern</dt><dd class="azure-risk-label @RiskClassFor(item.Risk)">@item.Risk</dd></div>
                        <div><dt>Requests / 5xx</dt><dd>@item.Requests7d.ToString("N0") / @item.Errors7d.ToString("N0")</dd></div>
                        <div><dt>Response</dt><dd>@(item.ResponseTimeMs is int ms ? $"{ms:N0} ms" : "—")</dd></div>
                        <div><dt>Location</dt><dd>@item.Location</dd></div>
                    </dl>
                </article>
            }
        </div>
    }
</section>

@code {
    /// <summary>The filtered rows to render.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ResourceExplorerItem> Items { get; set; } = [];

    /// <summary>Unfiltered row count, for the "N of M" result counter.</summary>
    [Parameter] public int TotalCount { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<string> Views { get; set; } = [];
    [Parameter] public string SelectedView { get; set; } = "";
    [Parameter] public EventCallback<string> SelectedViewChanged { get; set; }

    [Parameter, EditorRequired] public Func<string, BadgeStyle> StatusBadgeFor { get; set; } = default!;
    [Parameter, EditorRequired] public Func<string, string> RiskClassFor { get; set; } = default!;

    private IReadOnlyList<ResourceExplorerItem>? _renderedItems;
    private int _renderedTotal;
    private string? _renderedView;

    /// <summary>
    /// Guarded on every parameter that actually changes what is drawn — the rows, the counter
    /// and the selected view chip. The two <c>Func</c> parameters are excluded deliberately:
    /// they are fresh delegates on every parent render, so including them would make the guard
    /// a no-op, and they only ever affect output through the rows above.
    ///
    /// <para>The <c>IsNarrow</c> comparison that used to sit here went with the data grid: with
    /// one render tree there is no viewport-dependent branch left to invalidate on.</para>
    /// </summary>
    protected override bool ShouldRender()
    {
        if (ReferenceEquals(_renderedItems, Items)
            && _renderedTotal == TotalCount
            && _renderedView == SelectedView)
        {
            return false;
        }

        _renderedItems = Items;
        _renderedTotal = TotalCount;
        _renderedView = SelectedView;
        return true;
    }
}
