@page "/azure"
@rendermode WasmRenderModes.Interactive
@using Microsoft.AspNetCore.SignalR.Client
@using PoPunkouterSoftware.Shared
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject NotificationService NotificationService
@inject NavigationManager NavManager

<PageTitle>PoPunkouterSoftware — Azure status</PageTitle>

<div class="app-page azure-ops-page">
@if (_loading)
{
    <LoadingSkeleton Variant="summary" TileCount="4" AriaLabel="Loading Azure status" />
}
else if (!string.IsNullOrWhiteSpace(_loadError) || _summary is null)
{
    <ErrorRetryBanner Title="Azure status is unavailable." Message="@_loadError" OnRetry="LoadSummaryAsync" />
}
else
{
    var summary = _summary;
    var ageLabel = RelativeTime.Format(summary.GeneratedAt);
    // Tone is derived from the counts, never from the narrative text: parsing generated prose
    // to choose a colour is how a green band ends up above a paragraph about an outage.
    var narrativeTone = summary.BrokenServices > 0 ? "bad"
        : summary.ActionableCount > 0 ? "warn"
        : "good";

    @* The lead paragraph comes before the hero on purpose: it is the one element meant to be
       read first, and a plain-English sentence answers "what is going on" faster than four
       numbers do. *@
    <AzureStatusNarrative Summary="@CurrentAiSummary" AttentionItems="@summary.AttentionItems" Tone="@narrativeTone" />

    <header class="azure-command-header @(summary.AttentionCount > 0 ? "has-attention" : "is-healthy")" data-glass>
        <div class="azure-command-copy">
            <div class="app-kicker">Azure · @summary.SubscriptionName</div>
            <h1 class="azure-hero-title">
                @(summary.AttentionCount == 0 ? "Everything looks good" : $"{summary.AttentionCount} item(s) need attention")
                @if (summary.AttentionCount > 0)
                {
                    <RadzenBadge Text="@($"{summary.ActionableCount} actionable")" IsPill="true"
                                  BadgeStyle="BadgeStyle.Warning"
                                  title="Unavailable services plus security and cleanup findings — everything in the headline count except the staleness flag, which is cleared by refreshing rather than by fixing a resource." />
                }
            </h1>
            <div class="azure-command-meta">
                <span>Updated @ageLabel</span>
                <RadzenBadge Text="@(summary.IsStale ? "Stale data" : "Current")" IsPill="true"
                              BadgeStyle="@(summary.IsStale ? BadgeStyle.Danger : BadgeStyle.Success)" />
            </div>
        </div>
        @* Health claims inherit the report's age: "100% healthy" from a stale scan is a
           snapshot, not a status — the tiles must not contradict the Stale badge above. *@
        @* Each tile carries the shape behind its number. The series are projections of the
           same stored history the charts below use, so a tile and its chart can never
           disagree; a series with fewer than two points renders nothing at all rather than a
           misleading single dot. *@
        <div class="azure-command-kpis" aria-label="Azure status summary">
            <div>
                <strong>@summary.HealthPercent%</strong>
                <span>@(summary.IsStale ? $"Health as of {ageLabel}" : "Service health")</span>
                <Sparkline Points="@summary.HealthHistory" Tone="good" AriaLabel="Service health over the last 30 scans" />
            </div>
            <div>
                <strong>@summary.CostFormatted</strong>
                <span>30-day cost</span>
                <Sparkline Points="@summary.CostHistory" Tone="accent" AriaLabel="30-day cost over the last 30 scans" />
            </div>
            <div>
                <strong>@summary.BrokenServices</strong>
                <span>@(summary.IsStale ? $"Unavailable ({ageLabel})" : "Unavailable")</span>
                <Sparkline Points="@summary.BrokenHistory" Tone="bad" AriaLabel="Unavailable services over the last 30 scans" />
            </div>
            <div>
                <strong>@summary.TotalResources</strong>
                <span>Resources</span>
                <Sparkline Points="@summary.ResourceHistory" Tone="accent" AriaLabel="Resource count over the last 30 scans" />
            </div>
        </div>
        <div class="azure-command-actions">
            @if (_managementActionsEnabled)
            {
                @* Named for what it actually does. "Refresh" reads like the page reloads;
                   this starts a full ARM subscription scan that takes about half a minute,
                   which is worth knowing before clicking it. *@
                <RadzenButton Text="@(_refreshing ? "Rescanning Azure…" : "Rescan Azure")" Icon="refresh"
                              ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Disabled="@_refreshing" Click="RefreshAsync"
                              title="Runs a full Azure subscription scan (roughly 30 seconds). Progress streams live, and you can leave the page while it runs." />
                @if (_refreshing)
                {
                    <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="CancelRefreshAsync" />
                }
            }
            else
            {
                <span class="app-note" title="Management actions are disabled on this deployment. Set FeatureFlags:EnableManagementActions=true (and Security:ManagementApiKey if you want the extra API-key gate) in production appsettings to enable refresh, cancel, and pinger toggle.">
                    Read-only view — enable&nbsp;<code>FeatureFlags:EnableManagementActions</code>&nbsp;to unlock refresh controls
                </span>
            }
            @* Sonification. A second MODALITY on facts this page already renders — not a
               second copy of them — so the "each fact appears once" rule is intact: nothing
               new is reported here, the same summary is played instead of read.

               Outside the management gate on purpose: it costs nothing, calls no endpoint
               and mutates nothing, so it belongs with /api/diag/ai and the snooze endpoints
               on the unprivileged side. Clicking it while sound is off turns sound on — the
               click is itself the user gesture the autoplay policy requires, so this is the
               one place where opting in and hearing the result can happen in one action. *@
            <RadzenButton Text="Listen" Icon="graphic_eq" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Click="SonifyAsync" Disabled="@_sonifying"
                          title="Plays the fleet status as a four-second sound: health tunes the chord, outages add dissonance, spend sets the pulse rate, uptime opens the filter. Turns sound on if it is off." />
        </div>
    </header>

    @if (_refreshing)
    {
        <section class="azure-refresh-progress" aria-live="polite">
            @* Percent values only arrive over the hub; when it is down (HTTP-polling
               fallback) a determinate bar would sit at a lying 0% for the whole scan. *@
            @if (_hub?.State == HubConnectionState.Connected)
            {
                <RadzenProgressBar Value="@_progressPercent" Max="100" ShowValue="true" />
            }
            else
            {
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
            }
            <span><RadzenIcon Icon="sync" class="app-progress-icon" /> @_progressStep — you can leave this page while the scan continues.</span>
        </section>
    }

    @* Placed directly under the hero: "what moved" is the question a returning visitor
       actually arrives with, and it is answered from stored history with no extra request. *@
    <AzureWhatChanged Delta="@summary.Changes" />

    @* One grid, three cards. There used to be two grids and four cards, and the extra card
       was a donut restating the health ratio the hero already gives as a percentage — the
       same fact appeared in the hero tile, the card subtitle and the donut centre. The cost
       card likewise drew `CostHistory` whenever it had more than one point, which is the
       exact series the hero's cost sparkline already draws; it now always shows the per-
       resource-group breakdown, which appears nowhere else. Trend in the sparkline,
       breakdown in the chart, ratio in the hero — each fact rendered once. *@
    <section class="azure-glance-grid" aria-label="Spend forecast and Azure status charts">
        <AzureCostForecast Forecast="@summary.Forecast" />
        <article class="app-card" data-glass>
            <h2 class="azure-glance-title">30-day cost by resource group</h2>
            <div class="azure-glance-subtitle" aria-hidden="true">Top cost drivers this scan</div>
            @if (summary.CostDrivers.Count == 0)
            {
                <div class="azure-compact-state">No cost breakdown is available.</div>
            }
            else
            {
                <RadzenChart>
                    <RadzenBarSeries TItem="OpsMetricPoint" Data="@summary.CostDrivers" CategoryProperty="Label" ValueProperty="Value" Title="USD" />
                    <RadzenCategoryAxis /><RadzenValueAxis FormatString="${0:F0}"><RadzenGridLines Visible="true" /></RadzenValueAxis><RadzenLegend Visible="false" />
                </RadzenChart>
            }
            <span class="app-sr-only">@string.Join(", ", summary.CostDrivers.Select(x => $"{x.Label}: ${x.Value:F2}"))</span>
        </article>
        <article class="app-card" data-glass>
            <h2 class="azure-glance-title">Response time · slowest endpoints</h2>
            <div class="azure-glance-subtitle" aria-hidden="true">Current scan, milliseconds</div>
            @if (summary.ResponseTimes.Count == 0)
            {
                <div class="azure-compact-state success">No slow responses detected.</div>
            }
            else
            {
                <RadzenChart>
                    <RadzenBarSeries TItem="OpsMetricPoint" Data="@summary.ResponseTimes" CategoryProperty="Label" ValueProperty="Value" Title="ms" />
                    <RadzenCategoryAxis /><RadzenValueAxis FormatString="{0:N0} ms"><RadzenGridLines Visible="true" /></RadzenValueAxis><RadzenLegend Visible="false" />
                </RadzenChart>
                <p class="azure-chart-note">Free-tier apps sleep when idle — multi-second times are usually cold starts, not outages.</p>
            }
            <span class="app-sr-only">@string.Join(", ", summary.ResponseTimes.Select(x => $"{x.Label}: {x.Value:N0} milliseconds"))</span>
        </article>
    </section>

    @* Full-width on its own row, not a grid cell: 30 day-columns cannot share a row with
       anything else and still be readable at 390px. *@
    <AzureUptimeHeatmap Map="@summary.Uptime" />

    <section class="azure-attention-summary">
        <div class="azure-section-heading">
            <div><div class="app-kicker">Action first</div><h2>Needs attention</h2></div>
            <div class="azure-signal-badges">
                <RadzenBadge Text="@($"{summary.SecurityFindings} security")" IsPill="true" BadgeStyle="@(summary.SecurityFindings > 0 ? BadgeStyle.Danger : BadgeStyle.Success)" />
                <RadzenBadge Text="@($"{summary.CleanupCandidates} cleanup")" IsPill="true" BadgeStyle="@(summary.CleanupCandidates > 0 ? BadgeStyle.Warning : BadgeStyle.Success)" />
            </div>
        </div>
        @if (summary.AttentionItems.Count == 0)
        {
            <div class="azure-compact-state success"><RadzenIcon Icon="check_circle" /> No action is needed.</div>
        }
        else
        {
            <ol class="azure-simple-attention">
                @foreach (var item in summary.AttentionItems) { <li>@item</li> }
            </ol>
        }
    </section>

    @* ButtonStyle.Base (not .Light): Radzen's "Light" style hardcodes `color: var(--rz-base-200)`
       for the outlined variant in every theme — a near-white label, which is invisible on the
       light-mode surface. Base resolves to --rz-text-color, which the token bridge maps to
       --app-text, so it tracks both schemes. *@
    <div class="azure-advanced-toggle">
        <RadzenButton Text="@(_advancedOpen ? "Hide advanced diagnostics" : "Advanced diagnostics")"
                      Icon="@(_advancedOpen ? "expand_less" : "tune")" ButtonStyle="ButtonStyle.Base"
                      Variant="Variant.Outlined" Click="ToggleAdvancedAsync" />
    </div>

    @if (_advancedOpen)
    {
        <section class="azure-advanced" aria-label="Advanced Azure diagnostics">
        @if (_advancedLoading)
        {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else if (!string.IsNullOrWhiteSpace(_advancedError) || report is null)
        {
            <ErrorRetryBanner Message="@_advancedError" OnRetry="LoadReportAsync" />
        }
        else
        {
            var currentReport = report;
            var securityIssueCount = (currentReport.StorageInventory ?? new()).Sum(s => s.IssueCount)
                + (currentReport.ConfigDrift ?? new()).Sum(d => d.IssueCount);

            @* One-tap: the primary action fires on the main button; the secondary export
               lives behind the same control's caret instead of a second sibling button. *@
            <div class="azure-advanced-actions">
                <RadzenSplitButton Text="Download report" Icon="download" Size="ButtonSize.Small" Click="OnDownloadClick">
                    <RadzenSplitButtonItem Text="Full report (JSON)" Value="json" Icon="data_object" />
                    <RadzenSplitButtonItem Text="Audit script (PowerShell)" Value="script" Icon="terminal" />
                </RadzenSplitButton>
            </div>

            <AzurePriorityQueue Items="@PriorityQueue"
                                BadgeFor="@ActionabilityBadge"
                                OnCopyCommand="@CopyText"
                                OnSnooze="@SnoozePriorityItemAsync" />

            <AzureSnoozedItems Items="@_activeSnoozes" OnUnsnooze="@UnsnoozeEntryAsync" />

            <AzureResourceExplorer Items="@FilteredResourceExplorerItems"
                                   TotalCount="@ResourceExplorerItems.Count"
                                   Views="@ResourceViews"
                                   SelectedView="@_resourceView"
                                   SelectedViewChanged="@SetResourceView"
                                   IsNarrow="@_isNarrow"
                                   StatusBadgeFor="@ExplorerStatusBadge"
                                   RiskClassFor="@RiskClass" />

            <AzureEvidenceDisclosures Report="@currentReport"
                                      CleanupCandidates="@CleanupCandidates"
                                      SecurityIssueCount="@securityIssueCount"
                                      StepTimingTotalMs="@StepTimingTotalMs"
                                      ConfidenceBadgeFor="@ConfidenceBadge"
                                      OnSnooze="@SnoozeCleanupItemAsync">
                <HistorySection>
                    <AzureHistoryDisclosure StatusHistory="@ServiceStatusHistory"
                                            CostHistory="@CostHistory"
                                            SnapshotCount="@HistoryWindow.Count" />
                </HistorySection>
            </AzureEvidenceDisclosures>
        }
        </section>
    }
}
</div>
