@* The lead paragraph on /azure: a plain-English account of what is going on with the sites
   right now, written from every figure the scan produced (see StatusFactsBuilder and
   AiTriageService in Infrastructure). Precomputed once per scan and carried on
   OpsSummary.AiSummary, so first paint has it without a second request.

   Replaces the old AzureAiSummary card. It is a narrative band above the hero header rather
   than a card in the grid, because its job is to be the first thing read — a card three
   sections down is a card nobody reads.

   "Regenerate now" remains a direct consumer of POST /api/diag/ai: a fresh, unpersisted
   paragraph without a full Azure rescan. That path only has the attention-item list, so its
   output is thinner than the scan-time narrative — the badge says so. *@
@using System.Text.Json
@using PoPunkouterSoftware.Shared
@inject HttpClient Http

<section class="azure-narrative @($"is-{Tone}")" data-glass aria-label="Current status summary">
    <div class="azure-narrative__head">
        <span class="app-kicker">Right now</span>
        @if (Summary is not null)
        {
            <RadzenBadge Text="@SourceLabel(Summary.Source)" IsPill="true" BadgeStyle="@SourceBadgeStyle(Summary.Source)"
                          title="@SourceTitle(Summary.Source)" />
        }
    </div>

    @if (_adHocText is not null)
    {
        <p class="azure-narrative__text">@_adHocText</p>
        <div class="app-note">
            Ad-hoc regeneration — not saved with the scan, and written from the attention list only.
        </div>
    }
    else if (Summary is null || string.IsNullOrWhiteSpace(Summary.Text))
    {
        <p class="azure-narrative__text azure-narrative__text--muted">
            No status summary yet. Run a rescan to generate one from the latest Azure data.
        </p>
    }
    else
    {
        <p class="azure-narrative__text">@Summary.Text</p>
        <div class="app-note">
            Written @RelativeTime.Format(Summary.GeneratedAtUtc.UtcDateTime)
            @if (!string.IsNullOrWhiteSpace(Summary.Model))
            {
                <text> by @Summary.Model</text>
            }
        </div>
    }

    @if (_adHocError is not null)
    {
        <div class="app-note azure-narrative__error">@_adHocError</div>
    }

    <RadzenButton Text="@(_regenerating ? "Rewriting…" : "Rewrite this")" Icon="auto_awesome"
                  ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                  Disabled="@(_regenerating || AttentionItems is null)" Click="RegenerateAsync"
                  title="Ask the model for a fresh paragraph from the attention items, without running a full Azure rescan." />
</section>

@code {
    [Parameter] public AiSummaryResult? Summary { get; set; }

    /// <summary>Current attention items (from OpsSummary), sent to POST /api/diag/ai by
    /// "Rewrite this". Null before the summary has loaded — the button stays disabled.</summary>
    [Parameter] public IReadOnlyList<string>? AttentionItems { get; set; }

    /// <summary>
    /// Drives the band's accent colour so the paragraph is pre-attentively good/bad news
    /// before a word of it is read. Supplied by the page from the same counts the hero uses,
    /// rather than inferred from the text — parsing generated prose to pick a colour is how a
    /// green band ends up over a paragraph about an outage.
    /// </summary>
    [Parameter] public string Tone { get; set; } = "neutral";

    private bool _regenerating;
    private string? _adHocText;
    private string? _adHocError;

    private static string SourceLabel(string source) => source switch
    {
        "ai" => "AI",
        "cached" => "AI · unchanged",
        "template-fallback" => "Rule-based",
        "disabled" => "Rule-based (AI off)",
        _ => source,
    };

    private static string SourceTitle(string source) => source switch
    {
        "ai" => "Written by the Azure AI Foundry model during the latest scan.",
        "cached" => "Nothing material changed since the previous scan, so that scan's paragraph was reused instead of paying for another generation.",
        "template-fallback" => "AI is enabled but the model call failed — showing the rule-based narrative instead.",
        "disabled" => "FeatureFlags:EnableAiSummary is off — showing the rule-based narrative instead of a model call.",
        _ => source,
    };

    private static BadgeStyle SourceBadgeStyle(string source) => source switch
    {
        "ai" => BadgeStyle.Success,
        "cached" => BadgeStyle.Info,
        _ => BadgeStyle.Secondary,
    };

    private async Task RegenerateAsync()
    {
        if (AttentionItems is null || _regenerating)
            return;

        _regenerating = true;
        _adHocError = null;
        StateHasChanged();

        try
        {
            var payload = JsonSerializer.Serialize(
                new AiTriageAdHocRequest(AttentionItems), AppJsonContext.Default.AiTriageAdHocRequest);
            using var content = new StringContent(payload, System.Text.Encoding.UTF8, "application/json");
            using var resp = await Http.PostAsync("/api/diag/ai", content);
            if (!resp.IsSuccessStatusCode)
            {
                _adHocText = null;
                _adHocError = $"Rewrite failed ({(int)resp.StatusCode}).";
                return;
            }

            using var doc = JsonDocument.Parse(await resp.Content.ReadAsStringAsync());
            var root = doc.RootElement;
            var available = root.TryGetProperty("available", out var a) && a.ValueKind == JsonValueKind.True;
            if (available && root.TryGetProperty("summary", out var s) && s.ValueKind == JsonValueKind.String)
            {
                _adHocText = s.GetString();
            }
            else
            {
                _adHocText = null;
                _adHocError = "The model is unavailable right now (feature disabled or the deployment is unreachable).";
            }
        }
        catch (Exception ex)
        {
            _adHocText = null;
            _adHocError = ex.Message;
        }
        finally
        {
            _regenerating = false;
            StateHasChanged();
        }
    }
}
