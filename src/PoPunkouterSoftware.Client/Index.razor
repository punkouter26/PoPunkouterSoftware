@page "/"
@rendermode WasmRenderModes.Interactive
@using PoPunkouterSoftware.Shared
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>PoPunkouterSoftware — Web apps</PageTitle>

@* 3D starfield/globe backdrop — Three.js, catalog page only. Positioned behind <main>
   via Index.razor.css (fixed, negative z-index — same stacking tier as the shared
   #app-gpu-backdrop layer, which js/starfield-backdrop.js suppresses for as long as
   this canvas is alive so the two WebGL layers never both animate at once). Wired up
   from OnAfterRenderAsync/DisposeAsync below; see js/starfield-backdrop.js for the
   cost controls (lazy-loaded Three.js, capped frame rate, full pause on
   hidden/blur/reduced-motion, graceful no-WebGL degradation). *@
<canvas id="catalog-starfield" class="catalog-starfield" aria-hidden="true"></canvas>

<main id="main-content" class="app-page portfolio-page" tabindex="-1">
    <header class="portfolio-header">
        <div>
            <span class="app-eyebrow">PoPunkouterSoftware</span>
            <h1>Web apps</h1>
            <p>Small tools and experiments built with .NET and Azure.</p>
        </div>
    </header>

    @* Cache-mismatch banner: server BuildId has changed since the WASM bundle loaded,
       meaning what is on screen was rendered against outdated server state — offer a
       gentle "reload" that doesn't punish the visitor with a hard refresh. *@
    @if (data is not null
         && _buildIdAtLoad is not null
         && data.BuildId != _buildIdAtLoad
         && !_buildMismatchDismissed)
    {
        <div class="portfolio-build-banner" role="status">
            <RadzenIcon Icon="cloud_sync" />
            <div class="portfolio-build-banner__copy">
                <strong>The dashboard has been updated since this page loaded.</strong>
                <span>A newer build is live; click "Reload" to pick up the freshest inventory and live status.</span>
            </div>
            <button type="button" class="portfolio-build-banner__action" @onclick="HardReloadAsync">Reload</button>
            <button type="button" class="portfolio-build-banner__dismiss" aria-label="Dismiss update banner" @onclick="@(() => _buildMismatchDismissed = true)">×</button>
        </div>
    }

    @if (data is not null && data.Apps.Count > 0)
    {
        <div class="portfolio-summary" aria-live="polite">
            <strong>@data.Apps.Count apps</strong>
            @if (data.GeneratedAt is DateTime updated)
            {
                @* Focusable because the exact read time exists nowhere else on the page: the
                   visible text is relative, and `title` — which is what this used to be —
                   never appears on a touch device and is not announced on focus. *@
                <AppHint Class="@(data.Stale ? "is-stale" : "")" Focusable="true"
                         Text="@($"Last read {updated:u}.{(data.Stale ? " This page treats that as stale; the server rescans a stale inventory on its own." : "")}")">
                    Inventory updated @RelativeTime.Format(updated)@(data.Stale ? " · stale" : "")
                </AppHint>
            }
            <AppHint Class="portfolio-summary__auto"
                     Text="This list is re-read on every visit, and weekly in a tab left open.">
                auto-updates weekly
            </AppHint>
        </div>
    }

    @* The error banner sits ALONGSIDE the catalog, never instead of it. This used to be an
       `else if` ahead of the render branch while `data` was left populated, so one failed
       background auto-refresh — which fires unattended — replaced every
       rendered card with a banner and threw away catalog data still held in memory. A
       refresh that fails is a stale list, not an empty one. *@
    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <ErrorRetryBanner Title="@(data is null ? "The app list could not be loaded." : "The app list could not be updated — showing the last known catalog.")"
                          Message="@_loadError" OnRetry="LoadAppsAsync" />
    }

    @if (_loading && data is null)
    {
        <LoadingSkeleton Variant="cards" TileCount="6" AriaLabel="Loading portfolio" />
    }
    else if (data?.Apps.Count == 0)
    {
        <div class="app-empty-state">No apps are configured yet.</div>
    }
    else if (data is not null)
    {
        <section class="app-grid cards" aria-label="Web applications">
            @for (var i = 0; i < data.Apps.Count; i++)
            {
                var app = data.Apps[i];
                <PortfolioAppCard @key="app.Id" App="app" IsFirst="@(i == 0)" />
            }
        </section>
    }
</main>

@code {
    private PortfolioResponse? data;
    private long? _buildIdAtLoad;
    private bool _buildMismatchDismissed;
    private bool _loading;
    private string? _loadError;

    // Auto-refresh: every visit reads the catalog fresh, and a tab left open re-reads it
    // weekly. There is no manual "Reload catalog" button any more — the owner's call
    // (2026-09-26): the list changes on the scale of days, so a button and a 5-minute
    // timer were both answering a question nobody asks. Screenshots follow the same
    // weekly rhythm server-side (AppScreenshotService.MaxAge).
    private static readonly TimeSpan AutoRefreshEvery = TimeSpan.FromDays(7);
    private Timer? _autoRefreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAppsAsync();
        _autoRefreshTimer = new Timer(
            _ => _ = InvokeAsync(LoadAppsAsync), null, AutoRefreshEvery, AutoRefreshEvery);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Best-effort: a WebGL/Three.js failure must never break page load. All real
        // failure handling (no-WebGL, script-load errors, reduced-motion) lives inside
        // starfieldBackdrop.init() itself and resolves normally either way — this only
        // guards against the JS interop call itself failing (e.g. the module script
        // did not load).
        try
        {
            await JS.InvokeVoidAsync("starfieldBackdrop.init");
            await PushTelemetryAsync();
        }
        catch (JSException)
        {
            // Decorative layer only — the catalog is fully usable without it.
        }
    }

    /// <summary>
    /// Push the catalog's live health into the starfield's orbit field: healthy apps hold a
    /// tight orbit, unavailable ones drift outward, unmonitored ones sit calm but dim.
    ///
    /// <para>Strictly decorative. <c>apps.json</c> remains authoritative for the cards, and
    /// nothing here can remove, dim or reorder one — a probe failure produces a body that
    /// drifts, never a card that disappears. Same rule the catalog already follows for live
    /// Azure inventory, extended to the one part of the page that moves.</para>
    ///
    /// <para>A single delimited string, not a DTO: only primitives cross the interop
    /// boundary (the discipline every interop call here follows), so nothing new needs a
    /// <c>[JsonSerializable]</c> entry and the WASM trim analyzer stays clean.</para>
    /// </summary>
    private async Task PushTelemetryAsync()
    {
        if (data is null)
            return;

        // Separator-stripping is defensive, not theoretical: app names come from apps.json,
        // which is hand-edited, and one stray '|' would silently shift every subsequent
        // body's state by one field.
        var spec = string.Join(';', data.Apps.Select(a =>
            $"{a.Name.Replace('|', ' ').Replace(';', ' ')}|{OrbitState(a.Status)}"));

        try
        {
            await JS.InvokeVoidAsync("starfieldBackdrop.setTelemetry", spec);
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    /// <summary>
    /// Portfolio status → orbit state. "not-monitored" maps to <c>unknown</c>, not to a
    /// warning: no probe covers that app, and reporting a fault from an absence of data is
    /// the same mistake as counting a cold-start timeout as downtime.
    /// </summary>
    private static string OrbitState(string status) => status switch
    {
        "healthy" => "up",
        "unavailable" => "down",
        "degraded" => "warn",
        _ => "unknown",
    };

    public async ValueTask DisposeAsync()
    {
        _autoRefreshTimer?.Dispose();

        // Best-effort: the circuit may already be gone during teardown.
        try
        {
            await JS.InvokeVoidAsync("starfieldBackdrop.dispose");
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
        catch (TaskCanceledException) { }
    }

    private async Task LoadAppsAsync()
    {
        if (_loading) return;

        _loading = true;
        _loadError = null;
        try
        {
            // Per-call budget: the shared HttpClient's 5-minute timeout is sized for the
            // huge report endpoint; a hung portfolio call should fail in seconds, not minutes.
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            data = await Http.GetFromJsonAsync("/api/portfolio", AppJsonContext.Default.PortfolioResponse, cts.Token);
            if (_buildIdAtLoad is null && data?.BuildId > 0)
                _buildIdAtLoad = data.BuildId;

            // Also on the weekly auto-reload, not just the first paint — an app that goes
            // down while the tab is open should visibly leave its orbit. Safe to call before
            // the canvas exists: starfieldBackdrop holds the latest spec and applies it when
            // init() completes.
            await PushTelemetryAsync();
        }
        catch (Exception ex)
        {
            _loadError = FriendlyError.Describe(ex);
            Console.Error.WriteLine($"Portfolio load error: {ex}");
        }
        finally
        {
            _loading = false;
            // Load paths reached from a UI event get a render for free — ComponentBase renders
            // once when the handler's task yields and again when it completes. The
            // auto-refresh timer is NOT a UI event: InvokeAsync only marshals onto the
            // renderer's sync context, it does not schedule a render. So the timer (then
            // every five minutes) fetched a fresh catalog, replaced `data` with it, and nothing on screen
            // ever changed — the "auto-updates every 5 min" label was a promise the page did
            // not keep, and a card whose app went down kept rendering as healthy until someone
            // pressed the button. Rendering here covers every caller; the redundant render on
            // the event paths is one diff of a page whose children are all ShouldRender-guarded.
            StateHasChanged();
        }
    }

    private async Task HardReloadAsync()
    {
        // Refresh inventory view first; if user dismisses without reloading, at least the
        // data is fresh. If the build id is genuinely different, force a hard reload so
        // the WASM bundle matches the server.
        await LoadAppsAsync();
        try
        {
            await JS.InvokeVoidAsync("appHardReload");
        }
        catch
        {
            // swallow — we re-rendered the latest data above already
        }
    }
}
