@using PoPunkouterSoftware.Client.Components.Pages.Models
@using PoPunkouterSoftware.Shared.Azure
@using Radzen

@* The corroborating evidence behind the headline numbers, as progressive disclosure:
   collapsed by default so the page stays an answer rather than a data dump. Only the
   security block auto-opens, and only when it has findings.

   HistorySection is a RenderFragment rather than more parameters because the trend
   charts own their own data shape; see AzureHistoryDisclosure. *@
<section class="azure-anchor-section">
    <div class="azure-section-heading">
        <div><div class="app-kicker">Evidence</div><h2>Security, cleanup and history</h2></div>
    </div>
    <div class="azure-disclosure-stack">

        <details class="azure-disclosure" open="@(SecurityIssueCount > 0)">
            <summary class="azure-disclosure-heading">
                <span><RadzenIcon Icon="security" /><strong>Security and configuration</strong></span>
                <RadzenBadge Text="@($"{SecurityIssueCount} findings")" IsPill="true" />
            </summary>
            <div class="azure-disclosure-body">
                @if (SecurityIssueCount == 0)
                {
                    <div class="azure-compact-state success">Checks passed.</div>
                }
                @foreach (var storage in (Report.StorageInventory ?? []).Where(s => s.IssueCount > 0))
                {
                    <article class="azure-finding">
                        <strong>@storage.Name</strong>
                        <span>@storage.ResourceGroup · @storage.MinTls</span>
                        <p>@string.Join("; ", storage.Issues?.Select(i => i.Issue) ?? [])</p>
                    </article>
                }
                @foreach (var drift in (Report.ConfigDrift ?? []).Where(d => d.IssueCount > 0))
                {
                    <article class="azure-finding">
                        <strong>@(drift.FriendlyName ?? drift.Name)</strong>
                        <span>@drift.ResourceGroup · Configuration</span>
                        <p>@string.Join("; ", drift.Issues?.Select(i => i.Issue) ?? [])</p>
                    </article>
                }
            </div>
        </details>

        <details class="azure-disclosure">
            <summary class="azure-disclosure-heading">
                <span><RadzenIcon Icon="delete_sweep" /><strong>Cleanup evidence</strong></span>
                <RadzenBadge Text="@($"{CleanupCandidates.Count} candidates")" IsPill="true" />
            </summary>
            <div class="azure-disclosure-body">
                @if (CleanupCandidates.Count == 0)
                {
                    <div class="azure-compact-state success">No cleanup candidates.</div>
                }
                @foreach (var item in CleanupCandidates)
                {
                    <article class="azure-finding">
                        <strong>@item.Name</strong>
                        <span>@item.Type · @item.ResourceGroup</span>
                        <p>@item.Reason</p>
                    </article>
                }
            </div>
        </details>

        @if (Report.DowntimeDiagnoses?.Count > 0)
        {
            <details class="azure-disclosure">
                <summary class="azure-disclosure-heading">
                    <span><RadzenIcon Icon="troubleshoot" /><strong>Downtime diagnosis</strong></span>
                    <RadzenBadge Text="@($"{Report.DowntimeDiagnoses.Count} services")" BadgeStyle="BadgeStyle.Danger" IsPill="true" />
                </summary>
                <div class="azure-disclosure-body">
                    @foreach (var diagnosis in Report.DowntimeDiagnoses)
                    {
                        <article class="azure-finding">
                            <strong>@(diagnosis.FriendlyName ?? diagnosis.Name)</strong>
                            <span>@diagnosis.HttpStatus</span>
                            <p>@diagnosis.LikelyCause<br /><strong>Fix:</strong> @diagnosis.SuggestedFix</p>
                        </article>
                    }
                </div>
            </details>
        }

        @HistorySection

        <details class="azure-disclosure">
            <summary class="azure-disclosure-heading">
                <span><RadzenIcon Icon="speed" /><strong>Scan diagnostics</strong></span>
                <span class="app-note">@StepTimingTotalMs.ToString("N0") ms</span>
            </summary>
            <div class="azure-disclosure-body">
                @foreach (var timing in (Report.StepTimings ?? []).OrderByDescending(t => t.ElapsedMs))
                {
                    <div class="azure-timing-row"><span>@timing.Step</span><strong>@timing.ElapsedMs.ToString("N0") ms</strong></div>
                }
            </div>
        </details>

    </div>
</section>

@code {
    [Parameter, EditorRequired] public AzureReport Report { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<SafeToRemoveItem> CleanupCandidates { get; set; } = [];

    /// <summary>Storage plus config-drift findings; drives the badge and the auto-open.</summary>
    [Parameter] public int SecurityIssueCount { get; set; }

    [Parameter] public long StepTimingTotalMs { get; set; }

    /// <summary>The 30-day history disclosure, supplied by the page.</summary>
    [Parameter] public RenderFragment? HistorySection { get; set; }
}
