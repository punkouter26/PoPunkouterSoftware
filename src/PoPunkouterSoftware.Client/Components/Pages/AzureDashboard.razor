@page "/azure"
@rendermode WasmRenderModes.Interactive
@using Microsoft.AspNetCore.SignalR.Client
@using PoPunkouterSoftware.Shared.Azure
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject NotificationService NotificationService
@inject NavigationManager NavManager

<PageTitle>Po Software — Azure Status</PageTitle>

<div class="app-page azure-ops-page">
@if (_loading)
{
    <LoadingSkeleton Variant="summary" TileCount="4" AriaLabel="Loading Azure status" />
}
else if (!string.IsNullOrWhiteSpace(_loadError) || _summary is null)
{
    <ErrorRetryBanner Title="Azure status is unavailable." Message="@_loadError" OnRetry="LoadSummaryAsync" />
}
else
{
    var summary = _summary;
    var ageLabel = RelativeTime.Format(summary.GeneratedAt);
    var costSeries = summary.CostHistory.Count > 1 ? summary.CostHistory : summary.CostDrivers;

    <header class="azure-command-header @(summary.AttentionCount > 0 ? "has-attention" : "is-healthy")">
        <div class="azure-command-copy">
            <div class="app-kicker">Azure · @summary.SubscriptionName</div>
            <h1 class="azure-hero-title">
                @(summary.AttentionCount == 0 ? "Everything looks good" : $"{summary.AttentionCount} item(s) need attention")
                @if (summary.AttentionCount > 0)
                {
                    <RadzenBadge Text="@($"{summary.SecurityFindings + summary.CleanupCandidates} actionable")" IsPill="true"
                                  BadgeStyle="BadgeStyle.Warning"
                                  title="Actionable items exclude the staleness flag itself; they are the security + cleanup count from the JSON." />
                }
            </h1>
            <div class="azure-command-meta">
                <span>Updated @ageLabel</span>
                <RadzenBadge Text="@(summary.IsStale ? "Stale data" : "Current")" IsPill="true"
                              BadgeStyle="@(summary.IsStale ? BadgeStyle.Danger : BadgeStyle.Success)" />
            </div>
        </div>
        @* Health claims inherit the report's age: "100% healthy" from a stale scan is a
           snapshot, not a status — the tiles must not contradict the Stale badge above. *@
        <div class="azure-command-kpis" aria-label="Azure status summary">
            <div><strong>@summary.HealthPercent%</strong><span>@(summary.IsStale ? $"Health as of {ageLabel}" : "Service health")</span></div>
            <div><strong>@summary.CostFormatted</strong><span>30-day cost</span></div>
            <div><strong>@summary.BrokenServices</strong><span>@(summary.IsStale ? $"Unavailable ({ageLabel})" : "Unavailable")</span></div>
            <div><strong>@summary.TotalResources</strong><span>Resources</span></div>
        </div>
        <div class="azure-command-actions">
            @if (_managementActionsEnabled)
            {
                <RadzenButton Text="@(_refreshing ? "Refreshing…" : "Refresh")" Icon="refresh"
                              ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Disabled="@_refreshing" Click="RefreshAsync" />
                @if (_refreshing)
                {
                    <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="CancelRefreshAsync" />
                }
            }
            else
            {
                <span class="app-note" title="Management actions are disabled on this deployment. Set FeatureFlags:EnableManagementActions=true (and Security:ManagementApiKey if you want the extra API-key gate) in production appsettings to enable refresh, cancel, and pinger toggle.">
                    Read-only view — enable&nbsp;<code>FeatureFlags:EnableManagementActions</code>&nbsp;to unlock refresh controls
                </span>
            }
        </div>
    </header>

    @if (_refreshing)
    {
        <section class="azure-refresh-progress" aria-live="polite">
            @* Percent values only arrive over the hub; when it is down (HTTP-polling
               fallback) a determinate bar would sit at a lying 0% for the whole scan. *@
            @if (_hub?.State == HubConnectionState.Connected)
            {
                <RadzenProgressBar Value="@_progressPercent" Max="100" ShowValue="true" />
            }
            else
            {
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
            }
            <span><RadzenIcon Icon="sync" class="app-progress-icon" /> @_progressStep — you can leave this page while the scan continues.</span>
        </section>
    }

    <section class="azure-glance-grid" aria-label="Azure status charts">
        <article class="app-card">
            <h2 class="azure-glance-title">Service health</h2>
            <div class="azure-glance-subtitle" aria-hidden="true">@summary.ActiveServices of @summary.TotalServices services</div>
            <div class="azure-donut-wrap">
                <RadzenChart>
                    <RadzenDonutSeries TItem="OpsMetricPoint" Data="@summary.FleetHealth" CategoryProperty="Label" ValueProperty="Value" InnerRadius="72" />
                    <RadzenLegend Position="LegendPosition.Bottom" />
                </RadzenChart>
                <div class="azure-donut-center"><div class="azure-donut-pct">@summary.ActiveServices/@summary.TotalServices</div><div class="azure-donut-caption">healthy</div></div>
            </div>
            <span class="app-sr-only">@string.Join(", ", summary.FleetHealth.Select(x => $"{x.Label}: {x.Value}"))</span>
        </article>
        <article class="app-card">
            <h2 class="azure-glance-title">30-day cost by resource group</h2>
            <div class="azure-glance-subtitle" aria-hidden="true">@(summary.CostHistory.Count > 1 ? "Trend over the past 30 days" : "Snapshot — top cost drivers")</div>
            @if (costSeries.Count == 0)
            {
                <div class="azure-compact-state">No cost trend is available.</div>
            }
            else if (summary.CostHistory.Count > 1)
            {
                <RadzenChart>
                    <RadzenLineSeries TItem="OpsMetricPoint" Data="@costSeries" CategoryProperty="Label" ValueProperty="Value" Title="USD" />
                    <RadzenCategoryAxis /><RadzenValueAxis FormatString="${0:F0}"><RadzenGridLines Visible="true" /></RadzenValueAxis><RadzenLegend Visible="false" />
                </RadzenChart>
            }
            else
            {
                <RadzenChart>
                    <RadzenBarSeries TItem="OpsMetricPoint" Data="@costSeries" CategoryProperty="Label" ValueProperty="Value" Title="USD" />
                    <RadzenCategoryAxis /><RadzenValueAxis FormatString="${0:F0}"><RadzenGridLines Visible="true" /></RadzenValueAxis><RadzenLegend Visible="false" />
                </RadzenChart>
            }
            <span class="app-sr-only">@string.Join(", ", costSeries.Select(x => $"{x.Label}: ${x.Value:F2}"))</span>
        </article>
        <article class="app-card">
            <h2 class="azure-glance-title">Response time · slowest endpoints</h2>
            <div class="azure-glance-subtitle" aria-hidden="true">Current scan, milliseconds</div>
            @if (summary.ResponseTimes.Count == 0)
            {
                <div class="azure-compact-state success">No slow responses detected.</div>
            }
            else
            {
                <RadzenChart>
                    <RadzenBarSeries TItem="OpsMetricPoint" Data="@summary.ResponseTimes" CategoryProperty="Label" ValueProperty="Value" Title="ms" />
                    <RadzenCategoryAxis /><RadzenValueAxis FormatString="{0:N0} ms"><RadzenGridLines Visible="true" /></RadzenValueAxis><RadzenLegend Visible="false" />
                </RadzenChart>
                <p class="azure-chart-note">Free-tier apps sleep when idle — multi-second times are usually cold starts, not outages.</p>
            }
            <span class="app-sr-only">@string.Join(", ", summary.ResponseTimes.Select(x => $"{x.Label}: {x.Value:N0} milliseconds"))</span>
        </article>
    </section>

    <section class="azure-attention-summary">
        <div class="azure-section-heading">
            <div><div class="app-kicker">Action first</div><h2>Needs attention</h2></div>
            <div class="azure-signal-badges">
                <RadzenBadge Text="@($"{summary.SecurityFindings} security")" IsPill="true" BadgeStyle="@(summary.SecurityFindings > 0 ? BadgeStyle.Danger : BadgeStyle.Success)" />
                <RadzenBadge Text="@($"{summary.CleanupCandidates} cleanup")" IsPill="true" BadgeStyle="@(summary.CleanupCandidates > 0 ? BadgeStyle.Warning : BadgeStyle.Success)" />
            </div>
        </div>
        @if (summary.AttentionItems.Count == 0)
        {
            <div class="azure-compact-state success"><RadzenIcon Icon="check_circle" /> No action is needed.</div>
        }
        else
        {
            <ol class="azure-simple-attention">
                @foreach (var item in summary.AttentionItems) { <li>@item</li> }
            </ol>
        }
    </section>

    @* ButtonStyle.Base (not .Light): Radzen's "Light" style hardcodes `color: var(--rz-base-200)`
       for the outlined variant in every theme — a near-white label, which is invisible on the
       light-mode surface. Base resolves to --rz-text-color, which the token bridge maps to
       --app-text, so it tracks both schemes. *@
    <div class="azure-advanced-toggle">
        <RadzenButton Text="@(_advancedOpen ? "Hide advanced diagnostics" : "Advanced diagnostics")"
                      Icon="@(_advancedOpen ? "expand_less" : "tune")" ButtonStyle="ButtonStyle.Base"
                      Variant="Variant.Outlined" Click="ToggleAdvancedAsync" />
    </div>

    @if (_advancedOpen)
    {
        <section class="azure-advanced" aria-label="Advanced Azure diagnostics">
        @if (_advancedLoading)
        {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else if (!string.IsNullOrWhiteSpace(_advancedError) || report is null)
        {
            <ErrorRetryBanner Message="@_advancedError" OnRetry="LoadReportAsync" />
        }
        else
        {
            var currentReport = report;
            var securityIssueCount = (currentReport.StorageInventory ?? new()).Sum(s => s.IssueCount)
                + (currentReport.ConfigDrift ?? new()).Sum(d => d.IssueCount);

            @* One-tap: the primary action fires on the main button; the secondary export
               lives behind the same control's caret instead of a second sibling button. *@
            <div class="azure-advanced-actions">
                <RadzenSplitButton Text="Download report" Icon="download" Size="ButtonSize.Small" Click="OnDownloadClick">
                    <RadzenSplitButtonItem Text="Full report (JSON)" Value="json" Icon="data_object" />
                    <RadzenSplitButtonItem Text="Audit script (PowerShell)" Value="script" Icon="terminal" />
                </RadzenSplitButton>
            </div>

            <section class="azure-anchor-section">
                <div class="azure-section-heading"><div><div class="app-kicker">Ranked evidence</div><h2>Full priority queue</h2></div><RadzenBadge Text="@($"{PriorityQueue.Count} open")" IsPill="true" /></div>
                @if (PriorityQueue.Count == 0)
                {
                    <div class="azure-compact-state success"><RadzenIcon Icon="check_circle" /> No immediate action is required.</div>
                }
                else
                {
                    <div class="azure-attention-list">
                    @foreach (var item in PriorityQueue)
                    {
                        <article class="azure-attention-item">
                            <div class="azure-item-heading"><RadzenBadge Text="@item.Actionability" IsPill="true" BadgeStyle="@ActionabilityBadge(item.Actionability)" /><strong>@item.Item</strong><span class="azure-attention-reason">@item.Reason</span><span class="azure-impact-score">Impact @item.ImpactScore</span></div>
                            <div class="azure-attention-detail">
                                <dl><div><dt>Source</dt><dd>@item.Source</dd></div><div><dt>Confidence</dt><dd>@item.Confidence</dd></div><div><dt>Owner</dt><dd>@item.Owner</dd></div><div><dt>Environment</dt><dd>@item.Environment</dd></div></dl>
                                @if (!string.IsNullOrWhiteSpace(item.Command)) { <button class="azure-copy-command" @onclick="@(() => CopyText(item.Command))" title="Copy Azure CLI command"><code>@item.Command</code><RadzenIcon Icon="content_copy" /></button> }
                            </div>
                        </article>
                    }
                    </div>
                }
            </section>

            <section class="azure-anchor-section">
                <div class="azure-section-heading azure-resource-heading"><div><div class="app-kicker">Resource explorer</div><h2>All resources</h2></div><span class="azure-result-count">@FilteredResourceExplorerItems.Count of @ResourceExplorerItems.Count</span></div>
                @* Segmented control: one tap to switch view, with the selected state carried
                   by the control itself rather than five buttons each recomputing their own
                   ButtonStyle/Variant on every render. *@
                <div class="azure-filter-bar">
                    <RadzenSelectBar TValue="string" Value="@_resourceView" ValueChanged="SetResourceView"
                                     Size="ButtonSize.Small" aria-label="Filter resources">
                        <Items>
                            @foreach (var view in ResourceViews)
                            {
                                <RadzenSelectBarItem Text="@view" Value="@view" />
                            }
                        </Items>
                    </RadzenSelectBar>
                </div>
                @* One source of truth for the explorer. Both branches used to render
                   unconditionally, with CSS hiding whichever did not match the viewport —
                   so every row was built twice, into two live DOM trees. `_isNarrow` is
                   driven by a real matchMedia listener (see appMedia in helpers.js). *@
                @if (_isNarrow)
                {
                    <div class="azure-resource-cards">
                        @foreach (var item in FilteredResourceExplorerItems)
                        {
                            <article class="azure-resource-card" @key="item.Name"><div class="azure-resource-card-heading"><strong>@item.Name</strong><RadzenBadge Text="@item.Status" BadgeStyle="@ExplorerStatusBadge(item.Status)" IsPill="true" /></div><dl><div><dt>Type</dt><dd>@item.Type</dd></div><div><dt>Group</dt><dd>@item.ResourceGroup</dd></div><div><dt>Concern</dt><dd>@item.Risk</dd></div><div><dt>Requests / 5xx</dt><dd>@item.Requests7d.ToString("N0") / @item.Errors7d.ToString("N0")</dd></div></dl></article>
                        }
                    </div>
                }
                else
                {
                    @* Row virtualization replaces paging: the grid keeps a single scroll
                       container and only materialises the visible rows, so filtering never
                       reallocates the full row set. Height comes from scoped CSS. *@
                    <div class="azure-resource-grid">
                        <RadzenDataGrid Data="@FilteredResourceExplorerItems" TItem="ResourceExplorerItem" AllowSorting="true" AllowFiltering="true"
                                        AllowVirtualization="true" AllowPaging="false" AllowColumnResize="true"
                                        FilterMode="FilterMode.SimpleWithMenu" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal">
                            <Columns>
                                <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="Name" Title="Resource" Width="210px"><Template Context="item"><strong>@item.Name</strong></Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="Type" Title="Type" Width="150px" />
                                <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="ResourceGroup" Title="Resource group" Width="160px" />
                                <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="Status" Title="Status" Width="115px"><Template Context="item"><RadzenBadge Text="@item.Status" BadgeStyle="@ExplorerStatusBadge(item.Status)" IsPill="true" /></Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="Risk" Title="Concern" Width="130px"><Template Context="item"><span class="azure-risk-label @RiskClass(item.Risk)">@item.Risk</span></Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="Requests7d" Title="Req 7d" Width="90px" TextAlign="TextAlign.Right" />
                                <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="Errors7d" Title="5xx" Width="70px" TextAlign="TextAlign.Right" />
                                <RadzenDataGridColumn TItem="ResourceExplorerItem" Property="ResponseTimeMs" Title="Response" Width="100px" TextAlign="TextAlign.Right"><Template Context="item">@(item.ResponseTimeMs is int ms ? $"{ms:N0} ms" : "—")</Template></RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                }
            </section>

            <section class="azure-anchor-section">
                <div class="azure-section-heading"><div><div class="app-kicker">Evidence</div><h2>Security, cleanup and history</h2></div></div>
                <div class="azure-disclosure-stack">
                    <details class="azure-disclosure" open="@(securityIssueCount > 0)"><summary class="azure-disclosure-heading"><span><RadzenIcon Icon="security" /><strong>Security and configuration</strong></span><RadzenBadge Text="@($"{securityIssueCount} findings")" IsPill="true" /></summary><div class="azure-disclosure-body">
                        @if (securityIssueCount == 0) { <div class="azure-compact-state success">Checks passed.</div> }
                        @foreach (var storage in (currentReport.StorageInventory ?? new()).Where(s => s.IssueCount > 0)) { <article class="azure-finding"><strong>@storage.Name</strong><span>@storage.ResourceGroup · @storage.MinTls</span><p>@string.Join("; ", storage.Issues?.Select(i => i.Issue) ?? [])</p></article> }
                        @foreach (var drift in (currentReport.ConfigDrift ?? new()).Where(d => d.IssueCount > 0)) { <article class="azure-finding"><strong>@(drift.FriendlyName ?? drift.Name)</strong><span>@drift.ResourceGroup · Configuration</span><p>@string.Join("; ", drift.Issues?.Select(i => i.Issue) ?? [])</p></article> }
                    </div></details>
                    <details class="azure-disclosure"><summary class="azure-disclosure-heading"><span><RadzenIcon Icon="delete_sweep" /><strong>Cleanup evidence</strong></span><RadzenBadge Text="@($"{CleanupCandidates.Count} candidates")" IsPill="true" /></summary><div class="azure-disclosure-body">
                        @if (CleanupCandidates.Count == 0) { <div class="azure-compact-state success">No cleanup candidates.</div> }
                        @foreach (var item in CleanupCandidates) { <article class="azure-finding"><strong>@item.Name</strong><span>@item.Type · @item.ResourceGroup</span><p>@item.Reason</p></article> }
                    </div></details>
                    @if (currentReport.DowntimeDiagnoses?.Count > 0)
                    {
                        <details class="azure-disclosure"><summary class="azure-disclosure-heading"><span><RadzenIcon Icon="troubleshoot" /><strong>Downtime diagnosis</strong></span><RadzenBadge Text="@($"{currentReport.DowntimeDiagnoses.Count} services")" BadgeStyle="BadgeStyle.Danger" IsPill="true" /></summary><div class="azure-disclosure-body">@foreach (var diagnosis in currentReport.DowntimeDiagnoses) { <article class="azure-finding"><strong>@(diagnosis.FriendlyName ?? diagnosis.Name)</strong><span>@diagnosis.HttpStatus</span><p>@diagnosis.LikelyCause<br /><strong>Fix:</strong> @diagnosis.SuggestedFix</p></article> }</div></details>
                    }
                    <details class="azure-disclosure"><summary class="azure-disclosure-heading"><span><RadzenIcon Icon="timeline" /><strong>30-day history</strong></span><span class="app-note">@HistoryWindow.Count snapshots</span></summary><div class="azure-disclosure-body">
                        @if (HasHistory) { <div class="azure-history-grid"><article><h3>Fleet status</h3><RadzenChart><RadzenLineSeries TItem="StatusHistPoint" Data="@ServiceStatusHistory" CategoryProperty="Label" ValueProperty="Active" Title="Active" /><RadzenLineSeries TItem="StatusHistPoint" Data="@ServiceStatusHistory" CategoryProperty="Label" ValueProperty="Broken" Title="Broken" /><RadzenCategoryAxis /><RadzenValueAxis /></RadzenChart></article><article><h3>Cost</h3><RadzenChart><RadzenLineSeries TItem="TimePoint" Data="@CostHistory" CategoryProperty="Label" ValueProperty="Value" Title="USD" /><RadzenCategoryAxis /><RadzenValueAxis FormatString="${0:F0}" /></RadzenChart></article></div> }
                        else { <div class="azure-compact-state">History appears after two scans.</div> }
                    </div></details>
                    <details class="azure-disclosure"><summary class="azure-disclosure-heading"><span><RadzenIcon Icon="speed" /><strong>Scan diagnostics</strong></span><span class="app-note">@StepTimingTotalMs.ToString("N0") ms</span></summary><div class="azure-disclosure-body">@foreach (var timing in (currentReport.StepTimings ?? []).OrderByDescending(t => t.ElapsedMs)) { <div class="azure-timing-row"><span>@timing.Step</span><strong>@timing.ElapsedMs.ToString("N0") ms</strong></div> }</div></details>
                </div>
            </section>
        }
        </section>
    }
}
</div>
