<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>PoPunkouterSoftware - Ops Dashboard</title>
    <link rel="icon" href="images/favicon.ico" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/software-dark.css" />
    <link rel="stylesheet" href="css/modern-ui.css" />
    <link rel="stylesheet" href="PoPunkouterSoftware.Client.styles.css" />
    <HeadOutlet />
</head>
<body class="rz-background-color-base rz-color-base">
    <div id="app-nav-progress" style="position:fixed;top:0;left:0;width:0;height:2px;background:linear-gradient(90deg,#5b7cd6,#93b4f5);z-index:10000;transition:width .2s,opacity .3s;opacity:0;pointer-events:none"></div>
    <!-- Static boot splash: WASM (prerender: false) renders nothing until the runtime
         downloads, which previously meant a blank dark page for the entire first load.
         Pure HTML/CSS so it paints immediately; removed by the observer script below
         the moment Blazor renders its first component. -->
    <div id="app-boot-splash" aria-label="Loading" style="position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;background:#060a14;color:#94a3b8;z-index:9999;font-family:'Segoe UI',Arial,sans-serif;transition:opacity .3s">
        <div style="width:38px;height:38px;border-radius:50%;border:3px solid rgba(147,180,245,.22);border-top-color:#93b4f5;animation:app-boot-spin .8s linear infinite"></div>
        <div style="font-size:.95rem;letter-spacing:.04em">Loading PoPunkouterSoftware…</div>
        <style>@@keyframes app-boot-spin { to { transform: rotate(360deg); } }</style>
    </div>
    <Routes />
    <script>
        // Suppress expected hotreload errors in development
        const originalError = console.error;
        console.error = function(...args) {
            const msg = args[0]?.toString?.() || '';
            if (msg.includes('blazor-hotreload') || msg.includes('net::ERR_ABORTED')) {
                return;  // Silently ignore hotreload connection errors
            }
            originalError.apply(console, args);
        };
        // Remove the boot splash the moment Blazor renders real UI (the Radzen layout).
        (function () {
            var splash = document.getElementById('app-boot-splash');
            if (!splash) return;
            function dismiss() {
                splash.style.opacity = '0';
                setTimeout(function () { splash.remove(); }, 350);
            }
            var observer = new MutationObserver(function () {
                if (document.querySelector('.rz-layout, .app-topbar')) {
                    observer.disconnect();
                    dismiss();
                }
            });
            observer.observe(document.body, { childList: true, subtree: true });
            // Fail-safe: never trap the user behind the splash if boot detection misses.
            setTimeout(function () { observer.disconnect(); dismiss(); }, 30000);
        })();
        // Navigation progress bar for Blazor enhanced navigation
        (function () {
            var bar = null;
            function getBar() { return bar || (bar = document.getElementById('app-nav-progress')); }
            document.addEventListener('enhancednavigationstart', function () {
                var b = getBar(); if (!b) return;
                b.style.width = '40%'; b.style.opacity = '1';
                // Close the mobile drawer once a navigation begins, otherwise it stays
                // open across page changes and looks like a stuck overlay.
                document.body.classList.remove('topbar-open');
                var btn = document.querySelector('.app-topbar-menu');
                if (btn) { btn.setAttribute('aria-expanded', 'false'); if (btn.firstElementChild) btn.firstElementChild.textContent = 'menu'; }
            });
            document.addEventListener('enhancedload', function () {
                var b = getBar(); if (!b) return;
                b.style.width = '100%';
                setTimeout(function () { b.style.opacity = '0'; setTimeout(function () { b.style.width = '0'; }, 300); }, 200);
            });
        })();
    </script>
    <script src="js/helpers.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
</body>
</html>
